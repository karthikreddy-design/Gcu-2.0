{
  "name": "gcu-website",
  "version": "0.1.0",
  "private": true,
  "description": "Garden City University concept website",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node --check assets/main.js && node --check scripts/serve.mjs && node scripts/check.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "start": "node scripts/serve.mjs dist 0.0.0.0",
    "preview": "node scripts/serve.mjs dist"
  }
}
